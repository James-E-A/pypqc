recursive-include cffi_modules *.py

recursive-include lib/PQClean/crypto_*/mceliece*/clean *
recursive-include lib/PQClean/crypto_*/ml-dsa*/clean *
recursive-include lib/PQClean/crypto_*/sphincs*/clean *

